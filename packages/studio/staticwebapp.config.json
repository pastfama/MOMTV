{
  "globalHeaders": {
    "Access-Control-Allow-Origin": "https://momtv.surge.sh",
    "Access-Control-Allow-Methods": "GET, POST, OPTIONS",
    "Access-Control-Allow-Headers": "Content-Type, Authorization, api-key"
  },
  "routes": [
    {
      "route": "/api/*",
      "headers": {
        "Access-Control-Allow-Origin": "https://momtv.surge.sh",
        "Access-Control-Allow-Methods": "GET, POST, OPTIONS",
        "Access-Control-Allow-Headers": "Content-Type, Authorization, api-key"
      }
    }
  ],
  "responseOverrides": {
    "401": {
      "redirect": "/.auth/login/aad",
      "statusCode": 302
    }
  }
}