# ============================================================
# MOMTV - Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values.
# ============================================================

# --- Azure AI Foundry ---
# FOUNDRY_PROJECT_ENDPOINT is auto-injected by Azure when running hosted agents.
# Only needed for local agent development:
# FOUNDRY_PROJECT_ENDPOINT=https://your-resource.openai.azure.com/api/projects/your-project

# --- AI Model Deployment Names ---
# Auto-injected by Azure Foundry when running hosted agents.
# Only needed for local agent development:
# AZURE_AI_MODEL_DEPLOYMENT_NAME=gpt-5-mini

# --- Azure AI Speech (TTS) — only needed for local TTS testing ---
# AZURE_SPEECH_KEY=your-speech-key
# AZURE_SPEECH_REGION=eastus

# --- Studio ---
# The studio is a static frontend that connects to Foundry agents via HTTP.
# No environment variables needed for the studio.