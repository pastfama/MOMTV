# ============================================================
# MOMTV - Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values.
# ============================================================

# --- Azure Identity (Microsoft Entra ID) ---
AZURE_TENANT_ID=your-tenant-id
AZURE_CLIENT_ID=your-client-id
AZURE_CLIENT_SECRET=your-client-secret

# --- Azure AI Foundry ---
AZURE_AI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_AI_PROJECT_ID=your-project-id
AZURE_AI_API_VERSION=2024-12-01-preview

# --- AI Model Deployments (Foundry) ---
MODEL_VISION=gpt-4o
MODEL_VISION_DEPLOYMENT=gpt-4o
MODEL_REASONING=gpt-4o
MODEL_REASONING_DEPLOYMENT=gpt-4o
MODEL_FAST_REASONING=gpt-4o-mini
MODEL_FAST_DEPLOYMENT=gpt-4o-mini
MODEL_TRANSCRIPTION=whisper-large
MODEL_TRANSCRIPTION_DEPLOYMENT=whisper-large

# --- Azure AI Speech (TTS) ---
AZURE_SPEECH_KEY=your-speech-key
AZURE_SPEECH_REGION=eastus

# --- Redis (Event Bus) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- Stream Configuration (channels to watch 24/7) ---
# Format: platform:channel:language (comma-separated for multiple)
# Examples:
#   WATCHED_CHANNELS=twitch:shroud:en,twitch:xqc:en
#   WATCHED_CHANNELS=twitch:asilan:ru,twitch:shroud:en
# Or single channel:
#   STREAM_CHANNEL=shroud
WATCHED_CHANNELS=twitch:shroud:en

# --- Server ---
PORT=3001